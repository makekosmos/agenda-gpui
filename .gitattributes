# The a11y snapshot is byte-compared in tests (`actual != expected` against
# snapshots/a11y-inbox.txt). Pin LF so core.autocrlf does not rewrite it to
# CRLF on Windows checkouts and fail only there.
snapshots/** text eol=lf

# Binary payloads must never be EOL-normalized.
*.png binary
*.ico binary

# The Engine payload fixtures are a byte-exact contract compared against
# mapping::write output and copied verbatim into cortex — pin LF.
fixtures/**/*.json text eol=lf
