amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

// Rust files plus the inputs that change how they build or lint.
local rust_glob = List(
  "*.rs",
  "build.rs",
  "Cargo.toml",
  "Cargo.lock",
  "rust-toolchain*",
  ".cargo/**",
)

// Whole-project steps: run on every push and via `hk check --all`. They take no
// file list on purpose — a push must not skip the gate when file matching fails.
local gate = new Mapping<String, Step> {
  ["test"] {
    // Includes Engine protocol and cross-process persistence checks.
    check = "cargo nextest run --workspace --all-features --no-tests=pass"
  }
  ["cargo-shear"] { check = "cargo shear" }
  ["clippy"] {
    check = "cargo clippy --workspace --all-targets --all-features -- -D warnings"
  }
  ["cargo-deny"] { check = "cargo deny check advisories bans sources" }
  ["source-size"] { check = "cargo run -q --bin check-source-size" }
}

hooks {
  ["pre-commit"] {
    steps {
      ["cargo-check"] {
        glob = rust_glob
        check = "cargo check --quiet"
      }
      ["rustfmt"] {
        glob = List("*.rs", "build.rs")
        check = "cargo fmt --check"
      }
    }
  }
  ["pre-push"] {
    steps = gate
  }
  ["check"] {
    steps = gate
  }
}
